# ============================================
# AluuGPT Enterprise Configuration
# ============================================

# --- API CONFIGURATION ---
# Support for multiple models. First model is used for chat, others can be used via index.
# Format: model1,model2
MODELS=gpt-4,mistralai/Mistral-7B-Instruct-v0.2
API_KEYS=sk-proj-xxx,hf_xxx
BASE_URLS=https://api.openai.com/v1,https://api-inference.huggingface.co/models/

# --- SUGGESTED FREE MODELS (OpenAI Compatible) ---
# Hugging Face Inference (Free tier):
#   - mistralai/Mistral-7B-Instruct-v0.2
#   - meta-llama/Llama-2-7b-chat-hf
#   - google/gemma-7b-it
# Together AI (Free credits available):
#   - meta-llama/Llama-3-8b-chat-hf
#   - Qwen/Qwen2-72B-Instruct
# GROQ (Extremely fast, free beta tier):
#   - llama3-70b-8192
#   - mixtral-8x7b-32768

# --- ANIMATION SETTINGS ---
ANIMATION_OUTPUT_DIR=static/animations
ANIMATION_FPS=24

# --- MEMORY & EMBEDDINGS ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
MAX_CONTEXT_TOKENS=2000

# --- DATABASE / AUTH ---
DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# --- UI SETTINGS ---
DEFAULT_THEME=dark
UI_PORT=8000
DEBUG_MODE=false
